{
  "name": "wonderwp/dependency-injection",
  "description": "WonderWp DependencyInjection Component",
  "type": "library",
  "keywords": ["container", "dependecy-injection", "DI", "WonderWp", "WordPress"],
  "homepage": "https://github.com/wonderwp/DependencyInjection",
  "license": "MIT",
  "authors": [
    {
      "name": "Jeremy Desvaux",
      "homepage": "https://jdmweb.com"
    },
    {
      "name": "WonderWp Community",
      "homepage": "http://wonderwp.net/Contribution/Contributors.html"
    }
  ],
  "require": {
    "php": "^8.3",
    "pimple/pimple": "^3.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {"WonderWp\\Component\\DependencyInjection\\": "src"},
    "exclude-from-classmap": [
      "/Tests/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "WonderWp\\Component\\DependencyInjection\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist"
  },
  "minimum-stability": "dev"
}
